# Copy to .env and fill in values. NEVER commit real secrets.
# This file contains only placeholders.

# Tines webhook (used by the local simulator --send and the Lambda forwarder)
TINES_WEBHOOK_URL=
TINES_SHARED_SECRET=
TINES_SHARED_SECRET_HEADER=X-Tines-Shared-Secret
TINES_TIMEOUT_SECONDS=10
TINES_MAX_RETRIES=3

# GuardDuty minimum severity to forward (0.0 - 10.0)
GUARDDUTY_MIN_SEVERITY=0.0

# Jira Cloud (used only when real Jira mode is explicitly enabled)
JIRA_BASE_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SEC
JIRA_ISSUE_TYPE=Incident
JIRA_FINDING_ID_CUSTOM_FIELD=

# General
ENVIRONMENT=dev
PROJECT_NAME=guardduty-incident-response
